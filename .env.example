# GitHub Token (required)
# Create a personal access token with repo access at https://github.com/settings/tokens
GITHUB_TOKEN=your_github_token_here

# Repositories to analyze (required)
# Format: comma-separated list of users/orgs or specific repositories
# Examples:
#   - "octocat" - all repos from user 'octocat'
#   - "github,microsoft" - all repos from both orgs
#   - "octocat/Hello-World,github/docs" - specific repositories only
REPOSITORIES=user1,user2/specific-repo,org1

# Usernames for statistics aggregation (optional)
# When set, will create aggregated statistics for these users across all analyzed repos
# Multiple usernames can be specified as comma-separated values
# All specified usernames will be treated as the same person for aggregation
# Examples:
#   - "john-doe" - single username
#   - "john-doe,johndoe,j.doe" - multiple usernames for the same person
USERNAMES=your_username_here

# Maximum number of parallel threads for analysis (optional)
# Default: 4 threads. Increase for faster processing, decrease if hitting rate limits
# Recommended: 2-8 threads depending on your GitHub API rate limits
MAX_THREADS=4

# Cache duration in hours (optional)
# Default: 3 hours. Repositories analyzed within this period will be skipped
# Helps avoid GitHub API rate limits by not re-analyzing recently processed repos
# Set to 0 to disable caching
CACHE_HOURS=3

# Include private repositories (optional)
# Default: false (only public repositories)
# Set to 'true' to include private repositories in analysis
# Requires appropriate GitHub token permissions
INCLUDE_PRIVATE_REPOS=false